{
  "name": "feedback-mcp-server",
  "version": "3.0.0",
  "description": "A lightweight MCP server for interactive user feedback via browser dialogs",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "feedback-mcp": "dist/index.js",
    "feedback-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepack": "npm run build && node scripts/package-smoke.mjs --check",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/config.test.ts test/markdown.test.ts test/markdown-worker.test.ts test/html-template.test.ts test/html-runtime.test.ts test/browser-backend.test.ts test/native-backend.test.ts test/dialog-queue.test.ts test/mcp-protocol.test.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:e2e": "tsx scripts/e2e-smoke.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "feedback",
    "interactive",
    "dialog"
  ],
  "author": "NianLog <nianlog@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NianLog/feedback-mcp.git"
  },
  "homepage": "https://github.com/NianLog/feedback-mcp#readme",
  "bugs": {
    "url": "https://github.com/NianLog/feedback-mcp/issues"
  },
  "files": [
    "dist/",
    "assets/prism/",
    "assets/native/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "marked": "^16.4.1",
    "open": "^10.2.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.9.2",
    "@types/sanitize-html": "^2.16.1",
    "prismjs": "^1.29.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
