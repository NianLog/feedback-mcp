{
  "name": "feedback-mcp-server",
  "version": "2.2.0",
  "description": "A lightweight MCP server for interactive user feedback via browser dialogs",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "feedback-mcp": "dist/index.js",
    "feedback-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=18.2.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/config.test.ts test/markdown.test.ts test/html-template.test.ts test/browser-backend.test.ts test/native-backend.test.ts test/dialog-queue.test.ts",
    "test:e2e": "tsx scripts/e2e-smoke.ts"
  },
  "keywords": ["mcp", "model-context-protocol", "feedback", "interactive", "dialog"],
  "author": "NianLog <nianlog@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NianLog/feedback-mcp.git"
  },
  "homepage": "https://github.com/NianLog/feedback-mcp#readme",
  "bugs": {
    "url": "https://github.com/NianLog/feedback-mcp/issues"
  },
  "files": [
    "dist/",
    "assets/prism/",
    "assets/native/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^16.4.1",
    "open": "^10.2.0",
    "sanitize-html": "^2.17.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/sanitize-html": "^2.16.1",
    "prismjs": "^1.29.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
